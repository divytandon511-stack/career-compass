# Environment Mode (development | test | production)
NODE_ENV=development

# Server Port
PORT=4000

# Allowed CORS Origins (comma-separated list for credentialed browser clients)
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiter Window in milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per rate limit window
RATE_LIMIT_MAX=100

# Maximum JSON Request Body Size
BODY_LIMIT=100kb

