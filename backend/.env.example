# Environment Mode (development | test | production)
NODE_ENV=development

# Server Port
PORT=4000

# Allowed CORS Origins (comma-separated list for credentialed browser clients)
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiter Window in milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per rate limit window
RATE_LIMIT_MAX=100

# Maximum JSON Request Body Size
BODY_LIMIT=100kb

# JWT Access Token Configuration
# Required in development and production (minimum 32 characters, no predictable fallbacks).
# Generate a cryptographically secure random secret using:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_own_generated_32_plus_char_secret
JWT_EXPIRES_IN=900
JWT_ISSUER=career-compass
JWT_AUDIENCE=career-compass-client

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Local development binds to 127.0.0.1:5433 only
DATABASE_URL=postgresql://career_compass_dev:your_development_password_here@127.0.0.1:5433/career_compass?schema=public
